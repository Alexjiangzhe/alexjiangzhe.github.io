# Public repository allowlist. Everything else stays on this Mac.
/*
!/.gitignore
!/CNAME
!/README.md
!/package.json
!/server.mjs
!/content/
/content/*
!/content/site.json
!/public/
!/tools/
/tools/*
!/tools/build.mjs
!/tools/validate-site.mjs
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml
/public/.DS_Store
/public/**/.DS_Store
node_modules/
.env*
*.log
